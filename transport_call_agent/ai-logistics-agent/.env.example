# ---------- LiveKit (cloud.livekit.io -> your project -> Settings -> Keys) ----------
LIVEKIT_URL=wss://<your-livekit-url>
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# ---------- Groq (console.groq.com -> API Keys) : the LLM ----------
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# ---------- Voice ----------
# STT = Deepgram nova-3 and TTS = Cartesia sonic-3, both run through LiveKit Inference,
# so you only need your LiveKit keys for them.
CARTESIA_VOICE=YOUR_CARTESIA_VOICE_ID   # pick a multilingual voice you like
STT_LANGUAGE=en-IN          # English accent for speech-to-text (German/Polish are set automatically)
TURN_MODEL=on               # "off" = plain VAD (try this if Polish cuts people off)

# ---------- Agent ----------
AGENT_NAME=logistics-agent   # must match the dispatch rule (tasks.py uses this name)
COMPANY_NAME=Hi-Tec
# COMPANY_FACTS=...          # optional: facts the agent may use when callers ask questions

# ---------- Database ----------
DB_PATH=logistics.db

# ---------- Human hand-off (optional) ----------
OPERATIONS_PHONE=+9173056235161            # e.g. +48297430880 . Empty = no live transfer, agent promises a call-back
OPS_WEBHOOK_URL=             # optional Slack/Teams webhook for ops alerts
URGENT_WAIT_MINUTES=90       # a driver waiting this long counts as urgent

# ---------- Console test mode (python inbound.py console) ----------
CONSOLE_LANG=en              # en | de | pl
CONSOLE_PURPOSE=1            # 1 track | 2 new request | 3 driver issue
CONSOLE_PHONE=               # pretend caller number, e.g. +48501234567